#!/bin/sh
# Block commits that contain credentials, tokens or recordings.
fail=0
files=$(git diff --cached --name-only --diff-filter=ACM)
for f in $files; do
  case "$f" in
    .secrets/*|capture/*|*.har|*.flows|*.p12|*.pem|*.key|.env|*.env)
      echo "pre-commit: refusing to commit sensitive file: $f"; fail=1 ;;
  esac
done
# Google API keys, JWTs, bearer tokens, session cookies, private keys, refresh tokens
pattern='AIza[0-9A-Za-z_-]{30,}|eyJ[A-Za-z0-9_-]{15,}\.eyJ[A-Za-z0-9_-]{15,}|Bearer [A-Za-z0-9._-]{30,}|JSESSIONID=[A-Za-z0-9]{10,}|-----BEGIN [A-Z ]*PRIVATE KEY-----|"refresh_?[tT]oken"[[:space:]]*:[[:space:]]*"[^"]{20,}"|gh[pousr]_[A-Za-z0-9]{30,}'
hits=$(git diff --cached -U0 --diff-filter=ACM | grep -E '^\+' | grep -nE "$pattern")
if [ -n "$hits" ]; then
  echo "pre-commit: possible secret in staged changes:"
  echo "$hits" | sed -E 's/(AIza|eyJ|Bearer |JSESSIONID=|gh[pousr]_)([A-Za-z0-9._-]{4})[A-Za-z0-9._-]*/\1\2.../g' | cut -c1-160
  fail=1
fi
[ $fail -eq 0 ] || { echo "Commit blocked. Remove the secret (or move it to .secrets/)."; exit 1; }
